{
  "name": "@notificator-project/webflow",
  "version": "0.1.0",
  "private": true,
  "description": "Webflow App integration for Notificator.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "check": "node --check src/server.mjs && node --check netlify/functions/webflow.mjs && node --check src/webflow-security.mjs",
    "format": "prettier --write \"**/*.{js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md,yml,yaml}\"",
    "test": "node --test"
  },
  "dependencies": {
    "@notificator-project/api": "^0.1.2",
    "@netlify/blobs": "^10.3.0",
    "@supabase/supabase-js": "^2.57.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
